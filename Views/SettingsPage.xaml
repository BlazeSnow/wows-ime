<?xml version="1.0" encoding="UTF-8" ?>
<Page
    x:Class="wows_ime.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    mc:Ignorable="d">

    <Page.Content>
        <ScrollViewer
            VerticalScrollMode="Enabled"
            VerticalScrollBarVisibility="Auto"
            HorizontalScrollMode="Disabled"
            HorizontalScrollBarVisibility="Disabled">
        <Grid Padding="20" RowSpacing="8" Background="Transparent">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <toolkit:SettingsCard x:Name="LanguageCard" Grid.Row="0">
                <toolkit:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE8C1;" />
                </toolkit:SettingsCard.HeaderIcon>
                <ComboBox
                    x:Name="LanguageComboBox"
                    Width="160"
                    SelectionChanged="OnLanguageSelectionChanged">
                    <ComboBoxItem x:Name="AutomaticLanguageItem" Tag="auto" />
                    <ComboBoxItem Content="简体中文" Tag="zh-Hans" />
                    <ComboBoxItem Content="繁體中文" Tag="zh-Hant" />
                    <ComboBoxItem Content="日本語" Tag="ja" />
                </ComboBox>
            </toolkit:SettingsCard>

            <toolkit:SettingsCard
                x:Name="ProjectWebsiteCard"
                Grid.Row="1">
                <toolkit:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE774;" />
                </toolkit:SettingsCard.HeaderIcon>
                <Button x:Name="OpenProjectWebsiteButton" Click="OpenProjectWebsiteButton_Click" />
            </toolkit:SettingsCard>

            <toolkit:SettingsCard
                x:Name="ProjectRepositoryCard"
                Grid.Row="2">
                <toolkit:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE943;" />
                </toolkit:SettingsCard.HeaderIcon>
                <Button x:Name="OpenProjectRepositoryButton" Click="OpenProjectRepositoryButton_Click" />
            </toolkit:SettingsCard>

            <toolkit:SettingsCard x:Name="VersionCard" Grid.Row="3">
                <toolkit:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE946;" />
                </toolkit:SettingsCard.HeaderIcon>
                <TextBlock Text="{x:Bind AppVersionText}" />
            </toolkit:SettingsCard>
        </Grid>
        </ScrollViewer>
    </Page.Content>
</Page>
